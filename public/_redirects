# CampusFlow SPA Redirects — Compatible Netlify + Cloudflare Pages
# Maps dynamic /:orgSlug/* paths to the static placeholder _/ pages

# Nested routes first (most specific)
/:orgSlug/campus/*              /_/campus/index.html              200
/:orgSlug/login/*               /_/login/index.html               200
/:orgSlug/admin/*               /_/admin/index.html               200
/:orgSlug/library/*             /_/library/index.html             200
/:orgSlug/shop/*                /_/shop/index.html                200
/:orgSlug/messages/*            /_/messages/index.html            200
/:orgSlug/student/dashboard/*   /_/student/dashboard/index.html   200
/:orgSlug/student/*             /_/student/index.html             200
/:orgSlug/prof/dashboard/*      /_/prof/dashboard/index.html      200
/:orgSlug/prof/*                /_/prof/index.html                200
/:orgSlug/f/*                   /_/f/_/index.html                 200
/:orgSlug/                      /_/index.html                     200
/*                              /index.html                       200
